# GPU Server Tailscale Worker configuration (/etc/senior-meal-preview/gpu-worker.env)
# Leave WORKER_BIND_ADDR empty to auto-detect via `tailscale ip -4` (100.64.0.0/10).
WORKER_BIND_ADDR=
WORKER_PORT=8790
WORKER_MODE=dry-run

# Must match MODEL_WORKER_TOKEN on the EC2 Rust backend.
MODEL_WORKER_TOKEN=replace-with-shared-tailscale-worker-secret

# Required when WORKER_MODE=gpu (fails closed with HTTP 503 if neither is configured):
# Built-in sgedit path: only chicken_rice and tofu_rice, one change (extra_vegetables or brown_rice).
# Needs <dish_id>/input.png (1024x1024 RGB) and <dish_id>/mask_rice.png (1024x1024, rice region > 0).
WORKER_FIXTURE_DIR=/opt/senior-meal-preview/fixtures
# Directory that contains the research sgedit/ package. Run the worker with the BrushNet
# environment's Python (sgedit.paths.BRUSH_PY), and set SGEDIT_BASELINE / SGEDIT_WORK as for sgedit.
SGEDIT_REPO=/opt/ce7454-sgfood-edit
# Checker service on this machine: python -m sgedit.checker serve --port 8781
# It reads the fixture and candidate files by path, so it must share this filesystem.
WORKER_CHECKER_URL=http://127.0.0.1:8781
# Candidate cache (default: <WORKER_FIXTURE_DIR>/../candidates). Fill it once with:
#   python gpu_worker.py --mode gpu --warm
# WORKER_OUT_DIR=/opt/senior-meal-preview/candidates
# Optional external GPU command override (receives request JSON on stdin, outputs GpuArtifact JSON):
# WORKER_GPU_CMD=
